$ErrorActionPreference = "Continue"
$BASE = "http://localhost:5000/api"
$results = @()

function Test-API {
    param(
        [string]$TestId,
        [string]$Category,
        [string]$Description,
        [string]$Method,
        [string]$Url,
        [string]$Body = $null,
        [string]$Token = $null,
        [int[]]$ExpectedStatus = @(200),
        [string]$ExpectField = $null,
        [string]$ExpectValue = $null,
        [switch]$ExpectFail
    )
    
    $params = @{
        Uri = $Url
        Method = $Method
        ContentType = "application/json"
        ErrorAction = "SilentlyContinue"
    }
    if ($Body) { $params.Body = $Body }
    if ($Token) { $params.Headers = @{ Authorization = "Bearer $Token" } }
    
    try {
        $response = Invoke-WebRequest @params
        $statusCode = $response.StatusCode
        $content = $response.Content | ConvertFrom-Json
    } catch {
        $statusCode = $_.Exception.Response.StatusCode.value__
        if (!$statusCode) { $statusCode = 0 }
        try { $content = $_.ErrorDetails.Message | ConvertFrom-Json } catch { $content = $null }
    }
    
    $pass = $ExpectedStatus -contains $statusCode
    if ($ExpectFail -and $content -and $content.success -eq $true) { $pass = $false }
    if ($ExpectField -and $content) {
        $val = $content
        foreach ($p in $ExpectField.Split('.')) { $val = $val.$p }
        if ($ExpectValue -and $val -ne $ExpectValue) { $pass = $false }
    }
    
    $result = [PSCustomObject]@{
        TestId = $TestId
        Category = $Category
        Description = $Description
        Method = $Method
        Url = $Url
        StatusCode = $statusCode
        ExpectedStatus = ($ExpectedStatus -join ",")
        Pass = $pass
        ResponsePreview = if ($content) { ($content | ConvertTo-Json -Depth 3 -Compress).Substring(0, [Math]::Min(300, ($content | ConvertTo-Json -Depth 3 -Compress).Length)) } else { "NO_RESPONSE" }
    }
    $script:results += $result
    $symbol = if ($pass) { "PASS" } else { "FAIL" }
    Write-Host "[$symbol] $TestId - $Description (HTTP $statusCode)"
    return @{ Status = $statusCode; Content = $content; Pass = $pass }
}

