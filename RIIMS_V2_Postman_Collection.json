            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hariharan@reshandthosh.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["Auth", "forgot-password"]
            }
          }
        },
        {
